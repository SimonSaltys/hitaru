# Copy to .env and fill in. Settings set in the terminal take priority.
# .env is gitignored, so it stays on your computer.

# Discord status: the Application ID from https://discord.com/developers/applications
HITARU_DISCORD_CLIENT_ID=

# Optional overrides (defaults: Desktop\Shows, Documents\Hitaru, the aligner's ffmpeg)
# HITARU_LIBRARY=D:\Anime
# HITARU_DATA=
# HITARU_FFMPEG=
